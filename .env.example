# Gateway
PORT=8080
DATABASE_URL=postgres://urumi:urumi_dev@localhost:5432/urumi_gateway
JWT_SECRET=change-me-dev-only-min-32-chars-long-secret
JWT_EXPIRES_IN=12h
SEED_ADMIN_EMAIL=admin@urumi.local
SEED_ADMIN_PASSWORD=ChangeMe123!
UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_DISCOVERY_TIMEOUT_MS=5000
MCP_ROUTE_PREFIX=/mcp
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=
CHAT_MAX_ITERATIONS=6
CHAT_MAX_MESSAGE_CHARS=4000

# WooCommerce MCP
WOO_MCP_PORT=8081
WOOCOMMERCE_BASE_URL=http://host.docker.internal:8090
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key_here
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret_here
WOO_MCP_GATEWAY_TOKEN=

# Notes / Inventory MCP
NOTES_MCP_PORT=8082
INVENTORY_MCP_PORT=8083

# Dashboard (Vite — public, non-secret)
VITE_GATEWAY_URL=http://localhost:8080
VITE_APP_NAME=Urumi MCP Gateway

# Postgres (local dev / helm)
POSTGRES_DB=urumi_gateway
POSTGRES_USER=urumi
POSTGRES_PASSWORD=
